# Ponte Visual 2.0 — Backend · variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.

# Banco. No Railway, use a variável DATABASE_URL do plugin PostgreSQL.
# Local sem Postgres: deixe em branco para cair no SQLite (ponte_visual.db).
DATABASE_URL=

# Segurança JWT
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Object storage (S3 compatível) — mídia. Opcional na Fase 0.
S3_ENDPOINT=
S3_BUCKET=ponte-visual-midia
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Janela padrão de expiração do check-in (minutos)
CHECKIN_EXPIRACAO_MIN=120

# CORS: origens permitidas (separadas por vírgula). Produção = URL do Vercel.
# Ex.: https://tea-app.vercel.app,https://tea-app-tales.vercel.app
CORS_ORIGINS=http://localhost:5173
